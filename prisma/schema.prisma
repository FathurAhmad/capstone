generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"] // Hanya fokus pada skema public
}

model digital_evidence {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scan_id    String?    @db.Uuid
  photo_url  String
  latitude   Decimal?   @db.Decimal(9, 6)
  longitude  Decimal?   @db.Decimal(9, 6)
  remark     String?
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  scan_logs  scan_logs? @relation(fields: [scan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model discrepancies {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  manifest_item_id  String?         @db.Uuid
  expected_qty      Int
  actual_qty        Int
  variance          Int
  discrepancy_type  String?         @db.VarChar(50)
  resolution_status String?         @default("pending") @db.VarChar(50)
  resolved_by       String?         @db.Uuid
  resolved_at       DateTime?       @db.Timestamptz(6)
  created_at        DateTime?       @default(now()) @db.Timestamptz(6)
  manifest_items    manifest_items? @relation(fields: [manifest_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles          profiles?       @relation(fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

model inbound_sessions {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  manifest_id          String?     @db.Uuid
  gate_number          String?     @db.VarChar(50)
  actual_arrival       DateTime?   @db.Timestamptz(6)
  started_at           DateTime?   @default(now()) @db.Timestamptz(6)
  completed_at         DateTime?   @db.Timestamptz(6)
  driver_signature_url String?
  staff_signature_url  String?
  created_by           String?     @db.Uuid
  status               String?     @default("IN_PROGRESS") @db.VarChar(50)
  profiles             profiles?   @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manifests            manifests?  @relation(fields: [manifest_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scan_logs            scan_logs[]

  @@schema("public")
}

model manifest_items {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  manifest_id    String?         @db.Uuid
  part_id        String?         @db.Uuid
  expected_qty   Int
  expected_boxes Int?
  batch_code     String?         @db.VarChar(100)
  created_at     DateTime?       @default(now()) @db.Timestamptz(6)
  manifests      manifests?      @relation(fields: [manifest_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parts          parts?          @relation(fields: [part_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  qr_codes       qr_codes[]
  discrepancies  discrepancies[]

  @@schema("public")
}

model manifests {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  manifest_number     String             @unique @db.VarChar(100)
  vendor_id           String             @db.Uuid
  driver_name         String?            @db.VarChar(255)
  vehicle_plate       String?            @db.VarChar(50)
  departure_date      DateTime?          @db.Timestamptz(6)
  estimated_arrival   DateTime?          @db.Timestamptz(6)
  destination_address String?
  is_locked           Boolean?           @default(false) @map("is_locked")
  locked_at           DateTime?          @db.Timestamptz(6)
  status              ManifestStatus     @default(DRAFT)
  created_at          DateTime?          @default(now()) @db.Timestamptz(6)
  inbound_sessions    inbound_sessions[]
  manifest_items      manifest_items[]
  vendors             vendors            @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([vendor_id, created_at])
  @@schema("public")
}

model parts {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  part_number    String           @unique @db.VarChar(100)
  part_name      String           @db.VarChar(255)
  unit           String           @db.VarChar(20)
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?        @map("deleted_at")
  manifest_items manifest_items[]
  scan_logs      scan_logs[]

  @@schema("public")
}

model profiles {
  id               String             @id @db.Uuid
  email            String?            @db.VarChar(255)
  full_name        String?            @db.VarChar(255)
  role             String?            @db.VarChar(50)
  avatar_url       String?            @db.VarChar(255)
  vendor_id        String?            @db.Uuid
  updated_at       DateTime?          @default(now()) @db.Timestamptz(6)
  discrepancies    discrepancies[]
  inbound_sessions inbound_sessions[]
  deleted_at       DateTime?          @db.Timestamptz(6)

  // SATU-SATUNYA RELASI KE AUTH.USERS TELAH DIHAPUS DI SINI

  vendors   vendors?    @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scan_logs scan_logs[]

  @@schema("public")
}

model scan_logs {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id       String?            @db.Uuid
  user_id          String?            @db.Uuid
  part_id          String?            @db.Uuid
  qr_payload       String?            @unique @db.VarChar(255)
  actual_qty       Int
  scan_status      String?            @default("match") @db.VarChar(50)
  scanned_at       DateTime?          @default(now()) @db.Timestamptz(6)
  digital_evidence digital_evidence[]
  parts            parts?             @relation(fields: [part_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inbound_sessions inbound_sessions?  @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles         profiles?          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

model vendors {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendor_code String      @unique @db.VarChar(50)
  name        String      @db.VarChar(255)
  address     String?
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime?   @map("deleted_at")
  manifests   manifests[]
  profiles    profiles[]

  @@schema("public")
}

model qr_codes {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  manifest_item_id String    @db.Uuid
  qr_payload       String    @unique @db.VarChar(255) // Ini yang akan di-scan
  is_scanned       Boolean   @default(false)
  scanned_at       DateTime? @db.Timestamptz(6)

  manifest_items manifest_items @relation(fields: [manifest_item_id], references: [id], onDelete: Cascade)

  @@index([qr_payload])
  @@schema("public")
}

enum ManifestStatus {
  DRAFT
  LOCKED
  CHECKING
  COMPLETED
  DISCREPANCY

  @@schema("public")
}

enum ResolutionStatus {
  PENDING
  APPROVE
  HOLD
  RETURN
  RECOUNT

  @@schema("public")
}
